class=\"hljs-keyword\">let</span> data <span class=\"hljs-operator\">=</span> data <span class=\"hljs-keyword\">else</span> {\n    <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">\"No data received\"</span>)\n    <span class=\"hljs-keyword\">return</span>\n    }\n    \n    <span class=\"hljs-comment\">// Process the data (e.g., parse JSON)</span>\n    <span class=\"hljs-keyword\">do</span> {\n      <span class=\"hljs-keyword\">let</span> json <span class=\"hljs-operator\">=</span> <span class=\"hljs-keyword\">try</span> <span class=\"hljs-type\">JSONSerialization</span>.jsonObject(with: data, options: [])\n      <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">\"JSON: <span class=\"hljs-subst\">\\(json)</span>\"</span>)\n      } <span class=\"hljs-keyword\">catch</span> {\n        <span class=\"hljs-built_in\">print</span>(<span class=\"hljs-string\">\"Error parsing JSON: <span class=\"hljs-subst\">\\(error.localizedDescription)</span>\"</span>)\n        }\n        }\n        \n        <span class=\"hljs-comment\">// Start the data task</span>\n        task.resume()\n        ```\n</code></pre></div></div></div></div><div data-orientation=\"vertical\" data-state=\"hidden\" class=\"scroll-area__scrollbar_4ff0e\" style=\"top: 2px; bottom: 2px; right: 3px; --thumb-height: 112.69607843137256px;\"><div data-state=\"visible\" class=\"scroll-area__thumb_99821\" style=\"width: var(--thumb-width); height: var(--thumb-height); transform: translate3d(0px, 0px, 0px);\"></div></div></div></main><footer class=\"action-bar-ui__root_1be39\"><div class=\"action-bar-ui__left_d0acb macos__control_a52be\"><button data-state=\"closed\" data-has-hoverable-content=\"true\" class=\"action-button__button_d53a6 radius__radius-full_1cbd4\" data-variant=\"secondary\" data-hover-variant=\"outset\" data-interactive=\"true\" data-is-icon-only=\"false\" tabindex=\"-1\"><img class=\"action-button__icon_83d82\" src=\"/ds/assets/command-theme-studio-6fOuZRG