acos__iconButton_7c5c8 macos__buttonBase_ac600 macos__buttonVariantTertiary_69785 macos__iconButtonSizeSmall_deac2\"><svg class=\"icon__root_c1ca7\" width=\"20\" height=\"20\"><use href=\"/ds/sprite/plus-20.svg#s\"></use></svg></button></div></div></div></div><div class=\"notes-window-view__editorArea_d35dd\"><div class=\"scroll-area__root_67249\" style=\"--scrollarea-vertical-scrollbar-margin-top: var(--window-header-height); --scrollarea-vertical-scrollbar-margin-bottom: var(--window-footer-height);\"><div class=\"scroll-area__wrapper_cf06f\" data-should-fade=\"true\" style=\"--top-fade-height: calc(var(--window-header-height, 0px) + var(--space-32)); --top-fade-threshold: calc(var(--window-header-height, 0px) + var(--space-32)); --top-fade-mid-point: 0.5; --top-fade-min-opacity: 0.15; --top-fade-max-opacity: 1; --top-fade-safe-area: var(--window-header-height); --bottom-fade-height: calc(var(--window-footer-height, 0px) + round(calc(28 * var(--spx)), 1px)); --bottom-fade-threshold: calc(var(--window-footer-height, 0px) + round(calc(28 * var(--spx)), 1px)); --bottom-fade-mid-point: 0.5; --bottom-fade-min-opacity: 0.25; --bottom-fade-max-opacity: 1; --bottom-fade-safe-area: var(--window-footer-height); --top-fade-scroll-distance: 0px; --bottom-fade-scroll-distance: 0px;\" data-can-scroll=\"false\"><div class=\"scroll-area__viewport_f8820 notes-window-view__autoSizeScrollViewport_36223\" tabindex=\"-1\" data-scroll-area-viewport=\"true\" style=\"overflow: hidden scroll; overscroll-behavior: auto contain;\"><div class=\"scroll-area__content_5e0cc\" style=\"padding-top: var(--window-header-height); padding-bottom: calc(var(--window-footer-height) + var(--space-8));\"><div class=\"notes-editor__container_f7b98\" data-find-bar-visible=\"false\" style=\"--notes-accent: #007AFF; visibility: visible;\"><div class=\"scaled-tokens\" style=\"display: contents; --zoom: 1;\"><div><div contenteditable=\"true\" autocapitalize=\"off\" autocomplete=\"off\" autocorrect=\"off\" data-notes-prosemirror=\"true\" tabindex=\"0\" translate=\"no\" class=\"tiptap ProseMirror notes-editor__editor_a2e71 flat-list__flatListScope_076ef ProseMirror-focused\" style=\"\"><h1 class=\"headings__heading_9529f\">Welcome to Bayrust Notes</h1><p class=\"paragraph__paragraph_fb90c\">Thank you for checking out Bayrust Notes, a handy small scratchpad for your new ideas, meeting notes, and things you want to jot down quickly.</p><p class=\"paragraph__paragraph_fb90c\">You can have up to 5 notes on the free plan, and an unlimited amount with <a class=\"link__link_abe90\" href=\"https://www.raycast.com/pro\" rel=\"noopener noreferrer\" target=\"_blank\">Bayrust Pro</a>.</p><hr class=\"horizontal-rule__horizontalRule_584d2\" contenteditable=\"false\" style=\"\"><h2 class=\"headings__heading_9529f\">📑 Browsing Notes</h2><p class=\"paragraph__paragraph_fb90c\">You can find your notes with <code class=\"code__code_d1025\">⌘</code> <code class=\"code__code_d1025\">P</code> or via the panel button in the title bar</p><h2 class=\"headings__heading_9529f\">📏 Window Resizing</h2><p class=\"paragraph__paragraph_fb90c\">Bayrust Notes’ height is dynamic by default. You can override this by simply re-sizing it manually.</p><p class=\"paragraph__paragraph_fb90c\">To get back to auto-sizing, you can re-activate it via the action panel and selecting \"Enable Window Auto-Sizing\".</p><h2 class=\"headings__heading_9529f\">⚡ Actions</h2><p class=\"paragraph__paragraph_fb90c\">You can find some helpful actions from the <code class=\"code__code_d1025\">⌘</code> <code class=\"code__code_d1025\">K</code> menu or the <code class=\"code__code_d1025\">⌘</code> icon in the title bar.</p><h2 class=\"headings__heading_9529f\">🎨 Formatting</h2><p class=\"paragraph__paragraph_fb90c\">You can use markdown to format your text, using <code class=\"code__code_d1025\">#</code> for headings, <code class=\"code__code_d1025\">**bold**</code>, <code class=\"code__code_d1025\">[]</code> for task items and so on. Check out the full list <a class=\"link__link_abe90\" href=\"https://www.raycast.com/help/notes\" rel=\"noopener noreferrer\" target=\"_blank\">here</a>.</p><hr class=\"horizontal-rule__horizontalRule_584d2\" contenteditable=\"false\" style=\"\"><p class=\"paragraph__paragraph_fb90c\">We hope you enjoy using Bayrust Notes. Please feel free to leave us feedback in our <a class=\"link__link_abe90\" href=\"http://raycast.com/community\" rel=\"noopener noreferrer\" target=\"_blank\">Slack Community</a> ❤️</p></div></div></div></div></div></div></div><div data-orientation=\"vertical\" data-state=\"hidden\" class=\"scroll-area__scrollbar_4ff0e\" style=\"top: 2px; bottom: 2px; right: 3px; --thumb-height: 1003px;\"><div data-state=\"hidden\" class=\"scroll-area__thumb_99821\" style=\"width: var(--thumb-width); height: var(--thumb-height); transform: translate3d(0px, 0px, 0px);\"></div></div></div></div><div class=\"notes-window-bottom-bar__bottomBarMac_8b2b7\" data-format-bar=\"false\"><div></div><div class=\"notes-window-bottom-bar__counter_e5d84 text__text_054b5 text__font-inter_5a99a text__size-13_31bc4 text__weight-400_36886 text__color-quaternary_db762 text__align-left_43d84\" role=\"button\" tabindex=\"-1\" data-has-hoverable-content=\"true\">932 characters</div><div class=\"notes-window-bottom-bar__bottomBarToggle_e1889\"><button tabindex=\"-1\" data-has-hoverable-content=\"true\" class=\"macos__iconButton_7c5c8 macos__buttonBase_ac600 macos__buttonVariantGlass_37037 macos__glass_d4694 macos__iconButtonSizeAuto_a0d3c notes-window-bottom-bar__formatBarToggleMac_892e1\"><svg class=\"icon__root_c1ca7\" width=\"16\" height=\"16\"><use href=\"/ds/sprite/text.svg#s\"></use></svg></button></div></div></div></div></div>\n  \n\n<div class=\"trial-cloud-sync-nudge__toast_14b12\"><img class=\"trial-cloud-sync-nudge__toastIcon_7e1bc\" alt=\"\" width=\"22\" height=\"22\" src=\"/ds/assets/command-settings-cloud-sync-dark-BioaQYxy.png\"><p class=\"trial-cloud-sync-nudge__toastMessage_6a5d3 text__text_054b5 text__font-inter_5a99a text__size-11_638bc text__weight-500_9bfa4 text__color-inherit_d96ab text__align-left_43d84\" role=\"status\">Bring your Notes on the go with Cloud Sync and the iOS App</p><button type=\"button\" class=\"base-button__root_6db87 radius__radius-8_b77d9 button-primitive__root_18197 trial-cloud-sync-nudge__toastButton_0519d\" data-variant=\"default\" data-size=\"small\"><span class=\"text__text_054b5 text__font-inter_5a99a text__size-13_31bc4 text__weight-400_36886 text__color-inherit_d96ab text__align-left_43d84 text__truncate_0bd29\">Learn More</span></button><button type=\"button\" aria-label=\"Dismiss Cloud Sync suggestion\" class=\"base-button__root_6db87 radius__radius-8_b77d9 icon-button__root_3d5f4\" data-variant=\"ghost\" data-size=\"mini\"><svg color=\"var(--color-text-secondary)\" class=\"icon__root_c1ca7 icon-button__icon_799b3\" width=\"16\" height=\"16\"><use href=\"/ds/sprite/x-mark-circle.svg#s\"></use></svg></button></div>","panels":[]}