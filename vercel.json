{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix design-system/docs ci --no-audit --no-fund",
  "buildCommand": "npm --prefix design-system/docs run build",
  "outputDirectory": "design-system/docs/dist",
  "redirects": [
    {
      "source": "/command-icons",
      "destination": "/product-icons",
      "permanent": false
    },
    {
      "source": "/illustrations",
      "destination": "/iconography",
      "permanent": false
    },
    {
      "source": "/imagery",
      "destination": "/iconography",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!ds/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/ds/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
