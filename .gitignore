# dependencies and build output
node_modules/
design-system/docs/dist/
*.tsbuildinfo
__pycache__/
*.pyc
.DS_Store

# restored by scripts/setup.sh (the official Node release Raycast's backend runs on)
harness/runtime/

# runtime state: the sandboxed backend recreates its home on first run
harness/sandbox-home/
harness/logs/
*.pid

# generated by `npm run audit`
research/docs/audit/
research/docs/audit-light/

# the REA graphs are kept xz-compressed (each is over GitHub's 100 MB file limit); `xz -dk` restores them
research/rea-frontend-graph*.json

# AlignUI's docs were an information-architecture reference only, not part of Bayrust
reference/alignui/
research/alignui-extract.log

# Python environment for the image scripts (Pillow); scripts/setup.sh creates it
harness/.venv/

# audit and verify logs
research/docs/*.log

# the package build output (npm run build in packages/bayrust)
packages/bayrust/dist/
